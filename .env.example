# Which LLM the agents use: groq (default), lmstudio or ollama.
LLM_PROVIDER=groq

# Groq (https://console.groq.com). The free tier allows 8,000 tokens per minute per model, which the agents
# respect by trimming prompts; on a paid tier raise GROQ_TPM to your limit.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TPM=8000

# Local models through an OpenAI-compatible server, with no rate limits.
# LM Studio: load a model and start the server (default http://localhost:1234/v1).
# Ollama:    ollama pull gpt-oss:20b && ollama serve (default http://localhost:11434/v1).
# LOCAL_LLM_MODEL=openai/gpt-oss-20b
# LOCAL_LLM_URL=http://localhost:1234/v1
